# ─── API Server — environment variables ─────────────────────────────────────
# Copy to .env and fill in real values before starting.
#
# IMPORTANT: This server runs on Instance B (new Tencent Cloud VM).
#            Instance A hosts both OpenClaw and AiOC on the same machine.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# Bearer token that AiOC sends when calling this API server.
# Generate: node -e "console.log('api_' + require('crypto').randomBytes(32).toString('hex'))"
API_SERVER_SECRET=change-me-api-server-secret

# Origins allowed for CORS (comma-separated).
# In production, set exactly to your AiOC Cloudflare domain.
CORS_ORIGINS=https://askjary.com,http://localhost:3000

# ── OpenClaw gateway (Instance A) ─────────────────────────────────────────────
# HTTP URL of the OpenClaw gateway on Instance A.
# If this server can reach Instance A on its private/internal IP, use that.
OPENCLAW_GATEWAY_URL=http://10.0.0.X:18789

# WebSocket URL of the OpenClaw gateway on Instance A.
OPENCLAW_WS_URL=ws://10.0.0.X:18789

# HTTP hooks token (openclaw.json → hooks.token on Instance A)
OPENCLAW_HOOKS_TOKEN=hk_replace_me

# WebSocket auth token (openclaw.json → gateway.auth.token on Instance A)
OPENCLAW_WS_TOKEN=gw_replace_me

# Default agent ID for chat/briefing (must match an agent in openclaw.json)
OPENCLAW_DEFAULT_AGENT_ID=jary
