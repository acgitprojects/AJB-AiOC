# ─── Build-time environment variables ───────────────────────────────────────
# Copy this file to .env.production and fill in real values before running
# `npm run build:cf` or `npm run deploy:cf`.
#
# NEXT_PUBLIC_* variables are embedded into the client bundle by Next.js at
# build time. They CANNOT be injected as Cloudflare Worker runtime vars —
# they must be present when `opennextjs-cloudflare build` runs.
#
# DO NOT commit .env.production with real tokens.
# Add it to .gitignore if it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Server (Instance B — dedicated integration layer) ──────────────────────
# When set, ALL server-side OpenClaw calls route through the API server instead
# of hitting OpenClaw (Instance A) directly.
# Leave blank to call OpenClaw directly (no API server).
API_SERVER_URL=https://api.askjary.com

# Bearer token that AiOC sends to the API server (matches API_SERVER_SECRET in
# the api-server/.env on Instance B).
API_SERVER_SECRET=REPLACE_WITH_API_SERVER_SECRET

# ── Browser WebSocket connection (baked into client bundle at build) ──────────
# When using the API server: point to the API server's /ws endpoint.
# When calling OpenClaw directly: point to the OpenClaw gateway WS URL.
NEXT_PUBLIC_OPENCLAW_WS_URL=wss://api.askjary.com/ws

# The WS auth token sent in the browser handshake.
# When using API server: this must match API_SERVER_SECRET.
# When calling OpenClaw directly: use the gw_ token from openclaw.json.
NEXT_PUBLIC_OPENCLAW_WS_TOKEN=REPLACE_WITH_API_SERVER_SECRET

# ── Direct OpenClaw fallback (used when API_SERVER_URL is blank) ──────────────
# HTTP URL of the OpenClaw gateway on Instance A (only used when no API server).
OPENCLAW_GATEWAY_URL=https://oc.askjary.com

# HTTP hooks token (openclaw.json → hooks.token). Ignored when API_SERVER_URL set.
OPENCLAW_HOOKS_TOKEN=REPLACE_WITH_HOOKS_TOKEN

# ── Dashboard authentication ──────────────────────────────────────────────────
# Password users enter on the /login page.
DASHBOARD_PASSWORD=REPLACE_WITH_DASHBOARD_PASSWORD

# Session cookie value — use a long random string (e.g. openssl rand -hex 32)
DASHBOARD_SESSION_SECRET=REPLACE_WITH_SESSION_SECRET
