# ─── OpenClaw Gateway (server-side, never exposed to browser) ────────────────
# Copy this file to .env.local and fill in your values.
#
# Production (same server as OpenClaw): use http://127.0.0.1:18789 internally.
# Remote/dev: use the public domain https://gw.example.com
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_WS_URL=ws://127.0.0.1:18789

# HTTP hooks token — matches openclaw.json → hooks.token
OPENCLAW_HOOKS_TOKEN=your-hooks-token-here

# WS gateway token — matches openclaw.json → gateway.auth.token
OPENCLAW_WS_TOKEN=your-ws-token-here

# ─── NEXT_PUBLIC (readable by the browser) ───────────────────────────────────
# Browser connects directly to the public gateway over WebSocket.
NEXT_PUBLIC_OPENCLAW_WS_URL=wss://gw.example.com
NEXT_PUBLIC_OPENCLAW_WS_TOKEN=your-ws-token-here

# ─── Agent defaults ───────────────────────────────────────────────────────────
OPENCLAW_DEFAULT_AGENT_ID=hooks
OPENCLAW_SESSION_PREFIX=webchat

# ─── Dashboard auth ───────────────────────────────────────────────────────────
# Password users enter on the /login page.
DASHBOARD_PASSWORD=your-secure-password
# Opaque value stored as the session cookie. Keep this private and unique.
DASHBOARD_SESSION_SECRET=your-session-secret
