# ─── OpenClaw Gateway ───────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.

# Local gateway URL (default: ws + http on port 18789)
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_WS_URL=ws://localhost:18789

# Bearer token — must match openclaw.json → gateway.auth.token
OPENCLAW_TOKEN=your-secret-token-here

# Default agent ID to route messages to (normally "hooks" for the web client)
OPENCLAW_DEFAULT_AGENT_ID=hooks

# Session key prefix used to namespace this web client's conversations
OPENCLAW_SESSION_PREFIX=webchat

# Max seconds to wait for an agent response before timing out
OPENCLAW_TIMEOUT_SECONDS=60
